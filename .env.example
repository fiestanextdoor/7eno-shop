# ──────────────────────────────────────────────────────────────────────────────
# Template only: copy this file to .env.local and replace every placeholder
# with a real value. NEVER put real keys in this file; .env.example is the one



PRINTFUL_API_KEY=your_printful_api_key
# Set to "true" to auto-submit paid Printful orders for fulfillment (skips the
# manual draft/confirm step). Requires a payment method or Wallet balance in
# Printful billing. Leave unset/false while testing so orders stay deletable drafts.
PRINTFUL_AUTO_CONFIRM=false

# Use sk_test_/pk_test_ keys for local development. Live keys combined with
# AUTO_CONFIRM=true will create real charges and real fulfillment orders.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ──
# Order confirmation email, sent from the Stripe webhook once an order is paid
# and fulfilled. Without RESEND_API_KEY + ORDER_EMAIL_FROM, sending is skipped
# (logged, never fatal). Verify the 7eno.shop domain in Resend (SPF/DKIM DNS
# records) so mail is not flagged as spam, then set:
RESEND_API_KEY=your_resend_api_key
# Verified sender. Use the "Name <address@domain>" form; the domain must match
# the one verified in Resend.
ORDER_EMAIL_FROM=7ENO <orders@7eno.shop>
# Optional: blind-copy every confirmation to the shop's own inbox. Leave unset
# to email the customer only.
ORDER_EMAIL_BCC=orders@7eno.shop

# Local dev: http://localhost:3000 — production: https://www.7eno.shop
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Storefront seal preview key. Until launch (see lib/release.ts), proxy.ts
# redirects every page to /coming-soon. Visiting any URL with ?preview=THIS_VALUE
# drops a bypass cookie so you can browse the shop while it stays sealed to the
# public; ?preview=off clears it. Leave unset to disable bypassing entirely.
SITE_PREVIEW_KEY=

# Google Search Console site-verification token (the "content" value from the
# HTML-tag verification method). Renders <meta name="google-site-verification">
# on every page so Google can confirm domain ownership for OAuth app verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google OAuth "Web application" client ID (Cloud Console > Credentials). Used by
# the native Google Identity Services sign-in button so the Google consent screen
# shows our own domain (7eno.shop) instead of the Supabase project URL. Add our
# origins (https://www.7eno.shop, https://7eno.shop, http://localhost:3000) to the
# client's "Authorized JavaScript origins". When unset, sign-in falls back to the
# Supabase redirect flow. Public by design (the secret is not exposed).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secret for the gated diagnostics endpoint GET /api/health. Returns booleans
# only (no secret values) about the order pipeline: PRINTFUL_AUTO_CONFIRM state,
# whether the Printful API key works, and whether the Stripe webhook is
# registered + enabled. Without this set, the endpoint 404s. Call it with the
# x-healthcheck-key header (preferred) or ?key=THIS_VALUE.
HEALTHCHECK_SECRET=

# ── Printify (print-on-demand, second provider alongside Printful) ──
PRINTIFY_API_KEY=your_printify_personal_access_token
PRINTIFY_SHOP_ID=your_numeric_shop_id
PRINTIFY_CURRENCY=EUR
# Mirrors PRINTFUL_AUTO_CONFIRM: "true" auto-sends paid Printify orders to
# production (send_to_production). Leave false while testing so orders stay drafts.
PRINTIFY_AUTO_CONFIRM=false
# Secret used to verify incoming Printify status webhooks (HMAC). Returned when
# the webhook is created; store it here. Until set, status updates are skipped.
PRINTIFY_WEBHOOK_SECRET=

# ── Supabase (auth, database, image storage) ──
# Found in the Supabase dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only (never exposed to the client). Used for the remove.bg image cache
# in Supabase Storage and bypasses RLS, so keep it out of any NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# remove.bg API key, used to strip backgrounds from product mockups (results
# are cached in Supabase Storage). Without it, raw provider images are shown.
REMOVE_BG_API_KEY=
